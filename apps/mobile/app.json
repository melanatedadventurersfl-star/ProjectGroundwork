{
  "expo": {
    "name": "Melanated Adventurers",
    "slug": "melanated-adventurers",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "melanatedadventurers",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#17211B"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Melanated Adventurers to use your location for nearby Adventures and local weather."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Melanated Adventurers to access your photos so you can add memories to your adventures.",
          "cameraPermission": "Allow Melanated Adventurers to use your camera so you can add photos to your adventures.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.melanatedadventurers.app"
    },
    "android": {
      "package": "com.melanatedadventurers.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed241cfc-f4eb-4aa2-832f-ce76b1ec7c9c"
      }
    },
    "owner": "themelanated",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ed241cfc-f4eb-4aa2-832f-ce76b1ec7c9c"
    }
  }
}
