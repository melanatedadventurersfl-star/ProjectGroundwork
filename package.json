{
  "name": "project-groundwork",
  "version": "0.1.0",
  "private": true,
  "description": "Melanated Adventurers product blueprint and application workspace.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node apps/mobile/scripts/prepare_native_assets.js",
    "generate:icon": "node apps/mobile/scripts/prepare_native_assets.js",
    "bootstrap": "npm install && npm run check",
    "mobile:start": "npm --workspace @ma/mobile run start",
    "mobile:lint": "npm --workspace @ma/mobile run lint",
    "mobile:typecheck": "npm --workspace @ma/mobile run typecheck",
    "mobile:bundlecheck": "npm --workspace @ma/mobile run bundlecheck",
    "verify:mobile": "npm run mobile:lint && npm run mobile:typecheck && npm run mobile:bundlecheck",
    "check": "npm run verify:mobile"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "react": "19.2.3"
  }
}
