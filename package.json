{
  "name": "project-groundwork",
  "version": "0.1.0",
  "private": true,
  "description": "Melanated Adventurers product blueprint and application workspace.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "generate:icon": "python3 -m pip install --quiet pillow && python3 apps/mobile/scripts/generate_melanated_icon.py",
    "bootstrap": "npm install && npm run check",
    "mobile:start": "npm --workspace @ma/mobile run start",
    "mobile:lint": "npm --workspace @ma/mobile run lint",
    "mobile:typecheck": "npm --workspace @ma/mobile run typecheck",
    "check": "npm run mobile:lint && npm run mobile:typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "react": "19.2.3"
  }
}
